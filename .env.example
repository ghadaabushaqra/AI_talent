# Copy this file to .env. Never commit or share the real key.
# The app works without Ollama Cloud by using its deterministic agent fallback.
OLLAMA_API_KEY=replace_with_new_ollama_key
OLLAMA_CLOUD_MODEL=gpt-oss:20b-cloud
RAG_MODEL=intfloat/multilingual-e5-small
RAG_DENSE_ENABLED=true
RAG_LOCAL_FILES_ONLY=true
RAG_DENSE_WEIGHT=0.75
RAG_MIN_SCORE=0.18
